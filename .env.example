# Conexión como role_auth_service (cero privilegios de tabla)
DATABASE_URL=postgresql://role_auth_service:CHANGE_ME@localhost:5432/admin_platform

# Solo para `npm run seed:login` (bootstrap de un usuario admin de prueba):
# DSN de superusuario o rol LOGIN miembro de role_owner. NO usar en el servicio.
# ADMIN_DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/admin_platform

# AES-256-GCM de campos *_encrypted (32 bytes en base64)
PLATFORM_MASTER_KEY=CHANGE_ME_base64_32_bytes

# Firma del ticket efímero de login (clave de plataforma, no de tenant)
PLATFORM_TICKET_KEY=CHANGE_ME_base64_32_bytes

PORT=3001
HOST=0.0.0.0
# COOKIE_DOMAIN=example.com
# false SOLO en desarrollo local sin HTTPS
# COOKIE_SECURE=false
# Orígenes permitidos para CORS (lista blanca, separados por coma). Vacío =
# ningún origen cruzado. Como el servicio emite cookie de refresh, nunca debe
# usarse comodín. Ej: CORS_ORIGINS=https://admin.example.com,http://localhost:4200
CORS_ORIGINS=
LOG_LEVEL=info
