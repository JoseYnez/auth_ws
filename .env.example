# ── auth_ws · plantilla de entorno ───────────────────────────────────────────
# Copia estas claves en las variables de entorno del servicio en Dokploy.
# NODE_ENV=production ya lo fija el Dockerfile (activa las validaciones fail-fast
# de arranque). Los valores CHANGE_ME abortan el boot en producción a propósito.

# ── Base de datos (obligatorio) ───────────────────────────────────────────────
# Conexión como role_auth_service (cero privilegios de tabla; todo vía procedures).
DATABASE_URL=postgresql://role_auth_service:CHANGE_ME@db-host:5432/admin_platform

# ── Secretos de plataforma (obligatorio) ──────────────────────────────────────
# Genéralos con `pnpm gen:secrets`. NO reutilices los del ejemplo.
# PLATFORM_MASTER_KEY: AES-256-GCM del cifrado en reposo — exactamente 32 bytes en base64.
PLATFORM_MASTER_KEY=CHANGE_ME_base64_32_bytes
# PLATFORM_TICKET_KEY: firma del ticket efímero de login — mínimo 32 caracteres.
PLATFORM_TICKET_KEY=CHANGE_ME_min_32_chars

# ── Red ───────────────────────────────────────────────────────────────────────
PORT=3001
HOST=0.0.0.0

# ── Cookie de refresh ─────────────────────────────────────────────────────────
# COOKIE_SECURE debe ser true en producción (la cookie exige HTTPS).
COOKIE_SECURE=true
# strict = despliegue same-origin (recomendado). 'none' (+Secure) si el SPA vive
# en otro origen. 'lax' caso intermedio.
COOKIE_SAMESITE=strict
# Dominio de la cookie (opcional). Vacío = host exacto del servicio.
# COOKIE_DOMAIN=example.com

# ── CORS ──────────────────────────────────────────────────────────────────────
# Lista blanca de orígenes del/los front, separada por comas. En producción NO
# puede quedar vacía ni contener '*' (se emite cookie con credenciales).
CORS_ORIGINS=https://admin.example.com,https://cuenta.example.com

# ── Correo transaccional (reset de contraseña / invitaciones) ─────────────────
# Base pública del auth_app donde viven /reset y /invitation (sin barra final).
AUTH_APP_BASE_URL=https://cuenta.example.com
# 'console' registra el correo en el log (sin envío real); 'smtp-service'
# delega el envío en el microservicio smtp-service (notificacion_project).
MAIL_TRANSPORT=smtp-service
# smtp-service (obligatorio si MAIL_TRANSPORT=smtp-service): base URL sin barra
# final y api key del cliente (header X-Api-Key). El remitente lo resuelve el
# propio smtp-service según la cuenta.
SMTP_SERVICE_URL=http://localhost:3005
SMTP_SERVICE_API_KEY=CHANGE_ME
# Cuenta SMTP del cliente en smtp-service (opcional; vacío = cuenta default).
# SMTP_SERVICE_ACCOUNT_CODE=transactional

# ── Código OTP 2FA por SMS/WhatsApp (2FA multicanal, decisión #20) ───────────
# 'console' loggea el código (dev, sin envío real); 'twilio' envía de verdad
# (exige las 4 variables TWILIO_*, el boot aborta si falta alguna); 'memory'
# captura en un outbox (solo tests). El canal email usa MAIL_TRANSPORT.
OTP_SENDER_TRANSPORT=console
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=CHANGE_ME
# Remitentes en E.164; el prefijo whatsapp: lo añade el servicio.
# TWILIO_SMS_FROM=+15551234567
# TWILIO_WHATSAPP_FROM=+15551234567

# ── Operación ─────────────────────────────────────────────────────────────────
# NUNCA true en producción: apaga la única defensa contra fuerza bruta/credential-stuffing.
RATE_LIMIT_DISABLED=false
LOG_LEVEL=info
