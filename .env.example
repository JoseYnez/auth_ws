# Conexión como role_auth_service (cero privilegios de tabla)
DATABASE_URL=postgresql://role_auth_service:CHANGE_ME@localhost:5432/admin_platform

# AES-256-GCM de campos *_encrypted (32 bytes en base64)
PLATFORM_MASTER_KEY=CHANGE_ME_base64_32_bytes

# Firma del ticket efímero de login (clave de plataforma, no de tenant)
PLATFORM_TICKET_KEY=CHANGE_ME_base64_32_bytes

PORT=3001
HOST=0.0.0.0
# COOKIE_DOMAIN=example.com
# false SOLO en desarrollo local sin HTTPS
# COOKIE_SECURE=false
LOG_LEVEL=info
