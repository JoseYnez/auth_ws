{
  "name": "auth_ws",
  "version": "0.0.1",
  "description": "API de autenticación y permisos de la plataforma multitenant",
  "private": true,
  "type": "commonjs",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "seed:login": "tsx scripts/seed-login.ts",
    "gen:secrets": "tsx scripts/gen-secrets.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json}\"",
    "lint": "eslint src --max-warnings 0"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "argon2": "^0.44.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "jose": "^6.2.3",
    "nodemailer": "^9.0.3",
    "pg": "^8.21.0",
    "structure-verifier": "^1.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^25.9.3",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^9.0.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.2.5",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
